# ==============================================================================
# DigitalVault — environment variables
#
# Copy to `.env` and replace every value marked  <-- PUT YOUR VALUE HERE
# `.env` is gitignored and is NEVER committed.
#
# Where to put values:
#   Local dev ...... this file, in the project root
#   Vercel ......... Settings -> Environment Variables (set for Production AND
#                     Preview). Do NOT upload this file to Vercel.
#
# The site will NOT boot until DATABASE_URL and SESSION_SECRET are filled in.
# ==============================================================================


# ==============================================================================
# REQUIRED
# ==============================================================================

# --- 1. Database (pooled connection, used by the running app) ---------------
# Supabase:  Project Settings -> Database -> "Connection string" -> URI
# Vercel:    Storage -> Create Database -> Postgres -> connection strings
#
# Supabase requires &pgbouncer=true&connection_limit=1 on this one, otherwise
# serverless instances exhaust the connection budget and the site starts
# throwing "too many connections".
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true&connection_limit=1"   # <-- PUT YOUR VALUE HERE

# --- 2. Database (direct / non-pooled, used for migrations) -----------------
# Supabase: same page, but choose the "Direct connection" (NOT the pooler).
# Without this, `prisma db push` hangs behind the pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"   # <-- PUT YOUR VALUE HERE


# --- 3. Session signing key -------------------------------------------------
# Signs every login cookie. Anyone who reads this can forge an admin session,
# so treat a leak as a full compromise. MUST be at least 32 characters.
# Generate one:
#     openssl rand -base64 48
# or in PowerShell:
#     $b = New-Object byte[] 48
#     $r = New-Object System.Security.Cryptography.RNGCryptoServiceProvider
#     $r.GetBytes($b); $r.Dispose(); [Convert]::ToBase64String($b)
#
# The app REFUSES TO BOOT in production if this is missing, too short, or set
# to a known placeholder. If every page 500s, check this line first.
SESSION_SECRET="PASTE_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS_HERE"   # <-- PUT YOUR VALUE HERE


# --- 4. Public site URL -----------------------------------------------------
# The real origin of the deployed site. NO trailing slash.
#
# NEXT_PUBLIC_* values are compiled INTO THE BROWSER BUNDLE AT BUILD TIME, so
# changing this requires a REDEPLOY — restarting the server is not enough.
# Used by: Google OAuth redirect, sitemap.xml, robots.txt, canonical tags.
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"   # <-- PUT YOUR VALUE HERE


# ==============================================================================
# OPTIONAL
# ==============================================================================

# Server-only override that takes priority over NEXT_PUBLIC_SITE_URL.
# Leave unset unless server-generated links should differ from the public value.
# SITE_URL="https://your-app.vercel.app"

# Google sign-in. Find these in Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth 2.0 Client. Without them, "Continue with Google" shows a
# friendly error instead of starting OAuth.
# The Authorized redirect URI must match exactly:
#     https://your-app.vercel.app/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# google-site-verification meta token for Search Console ownership.
# GOOGLE_SITE_VERIFICATION=""

# Bearer token for POST /api/admin/chat/autoclose, so a Vercel Cron job can
# trigger it without a browser session. Any long random string.
# CRON_SECRET=""

# Overrides the global API rate limit (default 300/min in production).
# API_RATE_LIMIT_PER_MIN=300


# ==============================================================================
# LOCAL DEVELOPMENT ONLY — not needed on Vercel
# ==============================================================================

# Passwords for the accounts created by `npx tsx scripts/seed.ts`.
# If unset, the seeder generates a random one and prints it exactly once.
# ADMIN_SEED_PASSWORD=""
# BUYER_SEED_PASSWORD=""


# ==============================================================================
# DO NOT SET — managed by the platform
# ==============================================================================
# NODE_ENV      Vercel sets this to "production" automatically.
# VERCEL_URL    Vercel sets this to the deployment host automatically.

# ==============================================================================
# LOCAL DEV WITHOUT A POSTGRES SERVER
# ==============================================================================
# To run on your own machine with no database server, swap prisma/schema.prisma
# to SQLite and use the URL below instead of DATABASE_URL/DIRECT_URL:
#
#     datasource db {
#       provider = "sqlite"
#       url      = env("DATABASE_URL")
#     }
#
#     DATABASE_URL="file:./dev.db"
#
# Remember to switch the schema back to postgresql before deploying — SQLite
# cannot run on Vercel (the filesystem is read-only and wiped every deploy).
# ==============================================================================